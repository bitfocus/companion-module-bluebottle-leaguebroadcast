{
	"name": "bluebottle-leaguebroadcast",
	"version": "1.0.0",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"format:check": "prettier --check .",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-bluebottle-leaguebroadcast.git"
	},
	"bugs": {
		"url": "https://github.com/bitfocus/companion-module-bluebottle-leaguebroadcast/issues"
	},
	"homepage": "https://bluebottle.gg",
	"engines": {
		"node": "^22.20",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~1.14.1",
		"ws": "^8.21.3"
	},
	"devDependencies": {
		"@companion-module/tools": "^2.6.1",
		"@types/node": "^22.19.3",
		"@types/ws": "^8.18.1",
		"@vitest/coverage-v8": "4.1.10",
		"eslint": "^10.8.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"prettier": "^3.7.4",
		"rimraf": "^6.1.2",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.1.11"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.12.0"
}
